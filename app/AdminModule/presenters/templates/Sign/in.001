{block content}

{include '../alerts.latte'}

{form signInForm}
	
	<div class="row" style="background:#e8f0fe;padding-top:10px;height:60px;border-bottom:#0069cf solid 1px;">
   		<div class="container">
   		   <div class="col-sm-8 text-info text-bold">
                <h4><span class="icon fa fa-info"></span>&nbsp;LABMET&nbsp;{$Krecek5Version}&nbsp;|&nbsp;
                {if isset($h1)}{$h1|noescape} - {/if}
    			licence: {$projectCustomer} [doména: {$projectDomain}]
                </h4>    			
    	   </div>
    	   <div class="col-sm-4 text-info text-bold text-right">
    	       <h4><span class="icon fa fa-calendar"></span>&nbsp;{date(' d. m. Y')}</h4>
    	   </div>
		</div>    
    </div>

	<div class="container" style="padding-top:100px;">
		<div class="row">
			<div class="col-md-4 col-md-offset-4">
				<div class="login-panel panel panel-default">
					<div class="panel-heading">
						<h3 class="panel-title">Přihlášení do aplikace:&nbsp; <b class="text-info">{$projectDomain}</b></h3>
					</div>
					<div class="panel-body">
						{if $form->hasErrors()}
							<span class="icon fa fa-user"></span><div class="alert alert-danger" n:foreach="$form->errors as $error">{$error}</div>
						{/if}
						<div class="col-sm-1">
						  <span class="icon fa fa-user fa-2x"></span>
						  <br><br>
						  <span class="icon fa fa-lock fa-2x"></span>
						</div>
						<div class="col-sm-10">
    						<fieldset>
    							<div class="form-group">
    								{input username class=>'form-control', placeholder=>'Přihlašovací jméno', autofocus=>'true'}
    							</div>
    							<div class="form-group">
    								{input password class=>'form-control', placeholder=>'Heslo'}
    							</div>
    						</fieldset>
    					</div>
						{input submit class=>"btn btn-primary btn-block"}        					
					</div>
					<div class="panel-footer text-muted small">
						<span class="pull-right">i-LABMET {$Krecek5Version}</span> © 2015{if date('Y') > 2015}&ndash;{date('Y')}{/if}  <a href="http://www.iconsultdata.cz/" target="_blank">iConsultData</a>.
					</div>
				</div>
			</div>
		</div>
	</div>
{/form}


