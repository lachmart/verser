
{block content}


<div class="row">
	<div class="col-sm-3 text-right"><b>ID</b></div>
	<div class="col-sm-3">{$userObj->ID}</div>
</div>

<div class="row">
	<div class="col-sm-3 text-right"><b>Jméno</b></div>
	<div class="col-sm-3">{$userObj->NAME}</div>
</div>

<div class="row">
	<div class="col-sm-3 text-right"><b>Přihlašovací jméno</b></div>
	<div class="col-sm-3">{$userObj->LOGIN}</div>
</div>

<div class="row">
	<div class="col-sm-3 text-right"><b>Laboratoře - oprávnění</b></div>
	<div class="col-sm-3">{$userObj->LAB}</div>
</div>
