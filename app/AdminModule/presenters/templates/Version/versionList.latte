    <div class="alert alert-info" style="margin-bottom:0px; padding-bottom:8px;">
        <h4><span class="icon fa fa-codepen"></span>&nbsp;Popis systému</h4>
    </div>
    <select name="linked-methods" id="linked-method-dropdown" class="xhr-linked-methods form-control no-select2" onchange="location = this.value;">
        <option value="">--- vyberte ---</option>
        {foreach $systemList as $sl}
        <option value="{link Version:default,sid=>$sl['ID']}" {if $sl['ID'] == $sid} selected {/if}>{$sl['NAME']}</option>
        {/foreach}
    </select>
    <br/>
    <div class="method-list-inner">
        <table class="table table-hover method-list">
            <tr>
                <th colspan="2" style="background:#f4f4f4;">Přehled uvolněných verzí:</th>
            </tr>
            {foreach $versionList as $vl}
                <tr>
                    <td class="w30i">
                        {if $vl->ACTIVE == 1}
                            <span class="fa fa-toggle-on fa-lg text-success"></span>
                        {else}
                            <span class="fa fa-toggle-off fa-lg text-danger"></span>
                        {/if}
                    </td>
                    <td>
                        <a n:href="Version:default,sid=>$sid, vid=>$vl->ID" class="text-bold">
                            {if $vl->NAME != ""}
                                {$vl->NAME}
                            {else}
                                <i class="text-muted">neuvedeno</i>
                            {/if}
                        </a>
                        <br/>
                        <span class="icon fa fa-calendar"></span>&nbsp;{$vl->RELEASE_DATE}
                    </td>
                </tr>
            {/foreach}
        </table>
    </div>

<style type="text/css">
    .row-method-selected {
        background-color: #1ABC9C;
    }
</style>
