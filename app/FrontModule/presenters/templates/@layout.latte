<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="author" charset="Petr Kobelka, info@petrkobelka.cz, http://www.petrkobelka.cz">

		<title>i-VERSER</title>

		<script src="https://code.jquery.com/jquery-1.12.0.min.js"></script>

		<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
		<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap-theme.min.css" integrity="sha384-rHyoN1iRsVXV4nD0JutlnGaslCJuC7uwjduW9SVrLvRYooPp2bWYgmgJQIXwl/Sp" crossorigin="anonymous">
		<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>

		<link rel="stylesheet" href="{$basePath}/css/font-awesome.min.css">

		<link rel="stylesheet" href="{$basePath}/css/style.css">
		<meta name="viewport" content="width=device-width">

		{block head}{/block}
	</head>

	<body>
	
    <div class="row" style="margin-bottom:10px;">   
        <div class="well">
            <div class="container">
                <div style="">
              		<img src="{$basePath}/images/icdata_logo_40.jpg" alt="i-VERSER Client" />
              		<span class="pull-right">
                        <span class="glyphicon glyphicon-earphone"></span><span>&nbsp;+420&nbsp;774&nbsp;864&nbsp;357&nbsp;</span>                        
                        <span class="glyphicon glyphicon-envelope"></span><span>&nbsp;info@iconsultdata.cz</span>&nbsp;
                        <br>
                        <span class="pull-right h2 text-bold">i-VERSER</span>
                        <br>
                        <span class="pull-right h3">systém pro správu popisu verzí informačních systémů</span>
                    </span>
                </div>	
            </div>
        </div>
    </div>

	<div class="container">
		{include #content}
	</div>
    
    <footer class="footer" role="contentinfo">
       <div class="footer-container">
           <div class="footer-content">
                <div class="container">
                    <!-- div class="footer-logo text-center"><img alt="logo" class="logo" src="{$basePath}/images/surgalclinic_logo.svg" /></div -->
                    <div class="row">
                        <div class="col-sm-4">
                            <h3 class="footer-block">Naše adresa</h3>
                            <div><strong>i-VERSER</strong>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <h3 class="footer-block">Rychlý kontakt</h3>
                            <div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <h3 class="footer-block">Zajímavé odkazy</h3>
                        </div>    
                    </div>
                <br>
                <p align="center" class="container">Prezentovaná data jsou vlastnictvím i-CONSULT Data s.r.o. &copy;2019.</p>
                <br>                        
                </div>
            </div>
        </div>
     </footer>                                 
	{block scripts}

	<script src="https://nette.github.io/resources/js/netteForms.min.js"></script>
	<script src="//cdn.rawgit.com/vojtech-dobes/nette.ajax.js/2.0.0/nette.ajax.js"></script>
	<script src="{$basePath}/js/main.js"></script>
	{* datagrid - DataTables *}
	<script type="text/javascript" src="{$basePath}/js/DataTables/jquery.dataTables.js"></script>
	<script type="text/javascript" src="{$basePath}/js/DataTables/dataTables.bootstrap.min.js"></script>
	<script type="text/javascript" src="{$basePath}/js/de_sort.js"></script>
	{/block}

	</body>
</html>
