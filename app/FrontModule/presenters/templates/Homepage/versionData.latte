{if $id}
    <div class="alert bg-info text-bold">
        <span class="icon fa fa-file-text"><span>&nbsp;Seznam popisů verzí:
    </div>    

    <div class="method-list-inner">
    {foreach $versionListData as $vld} 
        {if ($vld->ACTIVE == 'A')}
            <div style="padding:5px;">
                <div class="w3-panel-primary">
                    <h3><span class="icon fa fa-check-square-o"><span>&nbsp;{$vld->TITLE} | {$vld->LAST_MODIFIED_DATE->format('d.m.Y')}</h3>
                    <hr class="w3-panel-primary-hr">                    
                </div>                
                <div class="text-right">
                    <a n:href="Version:versionDataForm id=>$vld->ID, vid=>$vld->VERSION_ID"  class="btn btn-info btn-sm" role="button">
                        <i class="icon fa fa-pencil"> </i>&nbsp;Editovat&nbsp;
                    </a>
                    <a n:href="Version:delete id=>$vld->ID, vid=>$vld->VERSION_ID"  class="btn btn-danger btn-sm" role="button">                            
                        <i class="icon fa fa-remove"> </i>&nbsp;Smazat&nbsp;
                    </a>
                </div>
            </div>
            <button type="button" class="btn btn-secondary" data-toggle="collapse" data-target="#description-{$iterator->counter}"><span class="icon fa fa-arrows-v"></span>&nbsp;Zobrazit/skrýt obsah popisu tématu</button>
            <div id="description-{$iterator->counter}" class="collapse">
                {$vld->DESCRIPTION|noescape}
            </div>                
        {else}
            <!-- div class="w3-block-warning" -->
            <div style="padding:5px;">
                <div class="w3-panel-warning">
                    <h3><span class="icon fa fa-edit"><span>&nbsp;{$vld->TITLE} | {$vld->LAST_MODIFIED_DATE->format('d.m.Y')}</h3>
                    <hr class="w3-panel-warning-hr">                                    
                </div>                
                <div class="text-right">
                    <a n:href="Version:versionDataForm id=>$vld->ID, vid=>$vld->VERSION_ID"  class="btn btn-info btn-sm" role="button">
                        <i class="icon fa fa-pencil"> </i>&nbsp;Editovat&nbsp;
                    </a>
                    <a n:href="Version:delete id=>$vld->ID, vid=>$vld->VERSION_ID"  class="btn btn-danger btn-sm" role="button">                            
                        <i class="icon fa fa-remove"> </i>&nbsp;Smazat&nbsp;
                    </a>
                </div>
            </div>
            <div class="bg-warning">
                {$vld->DESCRIPTION|noescape}                    
            </div>            
        {/if}
    {/foreach}
    </div>
{else}
    <div class="alert alert-info">
        <br/><br/>
        Pro zobrazení obsahu popisu veze je nutné zvolit požadavanou verzi systému!!
        <br/>
        Pokračujte výběrem požadované verze v panelu "Seznam popisů verzí".
        <br/><br/>
    </div>
{/if}
