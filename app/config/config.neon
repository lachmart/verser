parameters:
	version: 1.0.1

application:
#	errorPresenter: Error
	mapping:
		*: Lab\*Module\Presenters\*Presenter

session:
	expiration: 2 days

services:
	- Lab\Forms\FormFactory
	- Krecek5\Config
	- Lab\LabUser
	- Lab\Laboratory
	- Lab\Users\User
	- Version\Version
	authenticator: \Lab\Authenticator
	router: \Lab\RouterFactory::createRouter
#	database: @dibi
#	db: \Db

extensions:
	dibi: Dibi\Bridges\Nette\DibiExtension22
